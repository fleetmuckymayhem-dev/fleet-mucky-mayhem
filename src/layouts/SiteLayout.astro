---
import 'bootstrap/dist/css/bootstrap.min.css';
import '../scss/styles.scss';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {import.meta.env.FMM_STAGING === '1' && <meta name="robots" content="noindex, nofollow" />}

  <title>Fleet Mucky Mayhem - local group of social cyclists within the Fleet (Hampshire) and surrounding areas</title>
  <meta name="description"
    content="A sociable and welcoming cycling group in Fleet (Hampshire) and beyond, exploring scenic routes along towpaths, country lanes, and gentle trails. Open to all—come and ride with us!">
  <meta name="keywords"
    content="FleetMuckyMayhem, Fleet Mucky Mayhem Cycling group, Fleet Cycling group, Fleet Cycling Club, Fleet Towpath Cycling group">

  <!-- Google tag (gtag.js) -->
  
  

  <!-- Bing Webmaster tools -->
  <meta name="msvalidate.01" content="E35F8FAE08399E0E6A333B3CC23F10BE" />

  <link rel="icon" type="image/png" sizes="32x32" href="img/favicon-32x32.png">

  <!-- Our main entry point that imports Bootstrap -->
  

  <!-- Move all other script imports after Bootstrap is loaded -->
  
  
  
  
  
  
  

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Urbanist:ital,wght@0,100..900;1,100..900&display=swap"
    rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Roboto+Flex:opsz,wght@8..144,100..1000&display=swap"
    rel="stylesheet">

  <!-- Ensure Bootstrap Icons CSS is loaded -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.3.0/font/bootstrap-icons.css" rel="stylesheet">

</head>
<body data-bs-theme="dark">
<slot />
<script src="../scripts/site.ts"></script>
</body>
</html>
