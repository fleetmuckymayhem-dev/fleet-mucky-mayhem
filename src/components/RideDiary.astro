                <p>Additionally, please see "<em class="brand-text">General Information</em>" above</p>
              </div>
            </div>
          </div>

          <!-- Roller Coaster -->
          <div class="accordion-item">
            <h2 class="accordion-header" id="headingRegular-8">
              <button class="accordion-button collapsed ridesRegular lead brand-text" type="button"
                data-bs-toggle="collapse" data-bs-target="#collapseRegular-8" aria-expanded="false"
                aria-controls="collapseRegular-7">
